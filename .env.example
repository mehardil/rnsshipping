# Local development (npm run dev)
# Copy to .env.local and change the password before going live.
PORTAL_EMAIL=info@rns-shipping.com
PORTAL_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Production publishing (Netlify Functions in production)
# Create a fine-grained GitHub token with Contents: Read and write on this repo.
GITHUB_TOKEN=
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main
NETLIFY_BUILD_HOOK=
